# Local .terraform directories
.terraform/
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# .tfvars files are likely to contain sensitive data (passwords, keys) and
# should not be committed.
*.tfvars
*.tfvars.json

# Override files used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Helm
charts/**/charts/
charts/**/*.tgz

# macOS / editor cruft
.DS_Store
.idea/
.vscode/
